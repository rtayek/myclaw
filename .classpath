<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="src" output="bin/main" path="src">
		<attributes>
			<attribute name="gradle_scope" value="main"/>
			<attribute name="gradle_used_by_scope" value="main,test,integrationTest,slowTest,smokeTest"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="src" output="bin/test" path="tst/unit">
		<attributes>
			<attribute name="gradle_scope" value="test"/>
			<attribute name="gradle_used_by_scope" value="test"/>
			<attribute name="test" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="src" output="bin/integrationTest" path="tst/integration">
		<attributes>
			<attribute name="gradle_scope" value="integrationTest"/>
			<attribute name="gradle_used_by_scope" value="integrationTest"/>
			<attribute name="test" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="src" output="bin/smokeTest" path="tst/smoke">
		<attributes>
			<attribute name="gradle_scope" value="smokeTest"/>
			<attribute name="gradle_used_by_scope" value="smokeTest"/>
			<attribute name="test" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="src" output="bin/slowTest" path="tst/slow">
		<attributes>
			<attribute name="gradle_scope" value="slowTest"/>
			<attribute name="gradle_used_by_scope" value="slowTest"/>
			<attribute name="test" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21/"/>
	<classpathentry kind="con" path="org.eclipse.buildship.core.gradleclasspathcontainer"/>
	<classpathentry kind="output" path="bin/default"/>
</classpath>
